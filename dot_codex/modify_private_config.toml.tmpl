#!/bin/sh

tui_line='notifications = false'

awk -v tui_line="$tui_line" '
BEGIN {
    section = ""
    tui_seen = 0
    tui_section_seen = 0
    has_input = 0
}

/^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
    if (section == "tui" && !tui_seen) {
        print tui_line
        tui_seen = 1
    }

    section = $0
    sub(/^[[:space:]]*\[/, "", section)
    sub(/\][[:space:]]*$/, "", section)
    if (section == "tui") tui_section_seen = 1
}

{
    has_input = 1

    if (section == "" && $0 ~ /^[[:space:]]*notify[[:space:]]*=/) {
        next
    }

    if (section == "tui" && $0 ~ /^[[:space:]]*notifications[[:space:]]*=/) {
        if (!tui_seen) print tui_line
        tui_seen = 1
        next
    }

    print
}

END {
    if (!has_input) {
        print ""
        print "[tui]"
        print tui_line
    } else {
        if (section == "tui" && !tui_seen) print tui_line
        if (!tui_section_seen) {
            print ""
            print "[tui]"
            print tui_line
        }
    }
}
'
